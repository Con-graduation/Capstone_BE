# DailyGuitar — cp .env.example .env 후 값 입력. .env 는 커밋하지 마세요.
# 유출된 키는 Google Cloud / AWS 등에서 재발급·폐기하세요.

# Database
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USER=postgres
DB_PASS=

# 백엔드 JPA (로컬 예시)
DDL_AUTO=update

# Mail (Brevo)
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
MAIL_FROM=

# JWT (Base64 등 문자열 — 기존 하드코딩 값을 쓰려면 새 키로 교체 권장)
JWT_SECRET=
JWT_EXPIRATION=8640000000

# MCP — Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS S3
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PROFILE_PREFIX=profiles/

# Python 분석 (선택, EC2 경로 등)
AI_PYTHON_EXEC=python3
AI_PYTHON_SCRIPT_PATH=
AI_VIZ_DIR=
