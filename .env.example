# DailyGuitar 백엔드 + MCP 공통 — cp .env.example .env
# .env 는 커밋하지 마세요. 노출된 키는 콘솔에서 재발급·폐기하세요.

# ---- Database ----
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USER=postgres
DB_PASS=

DDL_AUTO=update

# ---- Mail (Brevo) ----
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
MAIL_FROM=

# ---- JWT (백엔드·MCP 동일) ----
JWT_SECRET=
JWT_EXPIRATION=8640000000

# ---- Google OAuth2 (메인 spring.security + MCP google.client.* 공통) ----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://www.dailyguitar.site/api/auth/google/callback

# ---- OpenAI ----
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini

# ---- YouTube Data API ----
YOUTUBE_API_KEY=

# ---- AWS S3 ----
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PROFILE_PREFIX=profiles/

# ---- MCP ----
MCP_SERVER_URL=http://127.0.0.1:8081
MCP_SERVER_PORT=8081

# ---- Python 분석 ----
AI_PYTHON_EXEC=python3
AI_PYTHON_SCRIPT_PATH=
AI_VIZ_DIR=
